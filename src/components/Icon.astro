---
/* Small line icons used in the sidebar. Add a new one by adding its SVG paths below. */
const icons = {
  location: '<path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  scholar: '<path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>',
  github: '<path d="m8 7-5 5 5 5"/><path d="m16 7 5 5-5 5"/>',
  orcid: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 9v6"/><path d="M12 9h2a3 3 0 0 1 0 6h-2V9z"/>',
  linkedin: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
};

interface Props {
  name: keyof typeof icons;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icons[name]}
/>
